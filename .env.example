# Audio Processing Configuration
# Copy this file to .env and customize for your environment

# ===========================
# AUDIO PATHS
# ===========================
INPUT_AUDIO_PATH=C:\ReposGithub\co-pilot-mind\atcVoiceGeneration\cruzeiroAlternate\voo_flymov1234_controleParaCopiloto1.wav
OUTPUT_AUDIO_PATH=C:\ReposGithub\co-pilot-mind\atcVoiceGeneration\cruzeiroAlternate\voo_flymov1234_controleParaCopiloto1Cleaned.wav
REFERENCE_AUDIO_PATH=

# ===========================
# FIR FILTER SETTINGS
# ===========================
FIR_FILTER_ENABLED=true
FIR_LOW_FREQ=250
FIR_HIGH_FREQ=3400
FIR_NUMTAPS=401
FIR_EQUALIZE=true

# ===========================
# WIENER DENOISE SETTINGS
# ===========================
WIENER_DENOISE_ENABLED=true
WIENER_NOISE_WINDOW_S=1.5
WIENER_ALPHA_SPEC=0.8
WIENER_ALPHA_DD=0.98
WIENER_BIAS_CORRECTION=1.5
WIENER_MIN_GAIN_DB=-15.0

# ===========================
# NEURAL ENHANCEMENT SETTINGS
# ===========================
NEURAL_ENHANCEMENT_ENABLED=true
NEURAL_STRATEGY=complex
NEURAL_DRY_WET=0.9
NEURAL_DEVICE=cuda
NEURAL_MODEL_NAME=dns64

# ===========================
# VAD GATE SETTINGS
# ===========================
VAD_GATE_ENABLED=true
VAD_FRAME_MS=30
VAD_MODE=3
VAD_HANG_MS=150
VAD_ATTEN_DB=80

# ===========================
# LOUDNESS NORMALIZATION SETTINGS
# ===========================
LOUDNESS_NORMALIZE_ENABLED=true
LOUDNESS_TARGET_DBFS=-20.0
LOUDNESS_TOP_DB=25.0

# ===========================
# RESAMPLING SETTINGS
# ===========================
RESAMPLING_ENABLED=true
RESAMPLING_TARGET_SR=16000
RESAMPLING_RES_TYPE=kaiser_best

# ===========================
# OUTPUT SETTINGS
# ===========================
SAVE_FILTERED_AUDIO=true
SAVE_VAD_SEGMENTS=false
SAVE_METRICS=false
LOG_PROCESSING=true

# ===========================
# METRICS SETTINGS
# ===========================
COMPUTE_LSD=false
COMPUTE_MFCC=false
COMPUTE_SNR=false
METRICS_N_FFT=512
METRICS_HOP_LENGTH=160
